# Optional API root for a separately deployed backend, including /api.
# Local development and preview proxy /api to http://localhost:8000.
VITE_API_BASE_URL=

# Override this if your local backend uses a different port.
VITE_API_PROXY_TARGET=http://localhost:8000

# Deepgram API key for real-time live streaming transcription (optional direct client override;
# if omitted, frontend securely requests token from backend)
VITE_DEEPGRAM_API_KEY=

# Vercel production build:
# VITE_API_BASE_URL=https://rgit-hack.onrender.com/api
