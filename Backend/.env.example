# MongoDB Atlas connection string (replica set required for transactions)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/relay?retryWrites=true&w=majority

# JWT signing secret, must be at least 32 characters
JWT_SECRET=replace-this-with-a-random-string-of-32+chars

# Secret used to authorize the cron endpoint (Authorization: Bearer <value>)
CRON_SECRET=replace-this-with-a-random-cron-secret

# Public URL of the frontend app, used for OAuth redirects
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins (in addition to FRONTEND_URL)
CORS_ORIGINS=http://localhost:5173

# Public base URL of this API, used to build OAuth callback URLs
API_BASE_URL=http://localhost:5000

# Google OAuth (leave blank to disable the provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (leave blank to disable the provider)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Hours a submitted handoff may wait for acknowledgement before it is flagged overdue
ACK_SLA_HOURS=48

# Notion Integration (Internal Integration Token)
# Create at https://www.notion.so/my-integrations with 'Read content' capabilities
NOTION_API_KEY=secret_replace_with_your_notion_internal_integration_token
NOTION_PAGE_ID=
NOTION_DATABASE_ID=

# Local dev port
PORT=5000

# Optional: separate database for integration tests (see README)
MONGODB_URI_TEST=
