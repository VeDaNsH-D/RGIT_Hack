# MongoDB Atlas connection string (replica set required for transactions)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/relay?retryWrites=true&w=majority

# JWT signing secret, must be at least 32 characters
JWT_SECRET=replace-this-with-a-random-string-of-32+chars

# Secret used to authorize the cron endpoint (Authorization: Bearer <value>)
CRON_SECRET=replace-this-with-a-random-cron-secret

# Public URL of the frontend app, used for OAuth redirects
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins (in addition to FRONTEND_URL)
CORS_ORIGINS=http://localhost:5173

# Public base URL of this API, used to build OAuth callback URLs
PORT=8000
API_BASE_URL=http://localhost:8000

# Google OAuth (leave blank to disable the provider)
# Register http://localhost:8000/api/auth/oauth/google/callback as an
# authorized redirect URI for a Google Web application OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (leave blank to disable the provider)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App Integration (leave blank if not using GitHub App repository integration)
# Numeric App ID from the App's settings page (not secret).
GITHUB_APP_ID=
# App slug, e.g. the "my-app" in github.com/apps/my-app (not secret).
GITHUB_APP_SLUG=
# Installation ID for the account/org that installed the App (not secret);
# used by `npm run smoke:github-app` and as a default for demos.
GITHUB_APP_INSTALLATION_ID=
# SECRET. The full contents of the .pem file downloaded from the App's
# "Private keys" section - NOT the SHA256 fingerprint shown on that page.
# Put it on one line with literal \n between lines, in double quotes:
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_APP_PRIVATE_KEY=

# Document uploads: max file size in bytes (default 10 MiB) and local storage
# directory (default: <os tmpdir>/relay-documents). Local storage is not durable
# on Vercel or multi-instance deployments.
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_STORAGE_DIR=

# Hours a submitted handoff may wait for acknowledgement before it is flagged overdue
ACK_SLA_HOURS=48

# Notion Integration (Internal Integration Token)
# Create at https://www.notion.so/my-integrations with 'Read content' capabilities
NOTION_API_KEY=secret_replace_with_your_notion_internal_integration_token
NOTION_PAGE_ID=
NOTION_DATABASE_ID=

# Jira Integration Configuration
# Base domain (e.g., https://your-domain.atlassian.net)
JIRA_HOST=https://your-domain.atlassian.net
# Atlassian account email
JIRA_EMAIL=your-email@example.com
# API Token created at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here
# Optional: default project key to query
JIRA_PROJECT_KEY=PROJ

# Slack Integration Configuration
# Bot user OAuth token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# Optional: default channel ID to ingest from (e.g., C0123456789)
SLACK_DEFAULT_CHANNEL_ID=C0123456789
# Optional: workspace domain for permalink generation (e.g., myworkspace or myworkspace.slack.com)
SLACK_WORKSPACE_DOMAIN=myworkspace

# Local dev port

# Optional: separate database for integration tests (see README)
MONGODB_URI_TEST=

# WhatsApp Cloud API (Twilio / Meta WhatsApp Business API - Zero browser automation)
WHATSAPP_CLOUD_PROVIDER=twilio
WHATSAPP_FROM_PHONE=+919021875564

# Twilio WhatsApp Credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+919021875564

# Meta WhatsApp Cloud API Credentials (Alternative)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Web Automation via Selenium (Optional Delivery Adapter)
WHATSAPP_WEB_ENABLED=false
WHATSAPP_WEB_BROWSER=chrome
WHATSAPP_WEB_PROFILE_DIR=.whatsapp-sessions
WHATSAPP_WEB_HEADLESS=false
WHATSAPP_WEB_NAVIGATION_TIMEOUT_MS=60000
WHATSAPP_WEB_ACTION_TIMEOUT_MS=30000
WHATSAPP_WEB_AUTH_CHECK_TIMEOUT_MS=45000
WHATSAPP_WEB_DEFAULT_PHONE=+919021875564

# Agora API keys and app certificate for real-time audio, video and chat features 
AGORA_APP_ID=f4825a2c2aae4e55841b38d6afb6472e
AGORA_APP_CERTIFICATE=15e4ee0d6369493ab7c15d5675773aed

# Mailbox integration: Google needs Gmail API enabled and gmail.readonly consent.
# Additional authorized redirect URI:
# http://localhost:8000/api/email/oauth/gmail/callback
# Microsoft app registration (work/school and personal Outlook accounts):
# http://localhost:8000/api/email/oauth/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Optional dedicated encryption secret for persisted mailbox tokens.
# Set a strong random value before connecting mailboxes; otherwise JWT_SECRET is used.
EMAIL_TOKEN_ENCRYPTION_KEY=
# Project invitation email (Nodemailer SMTP; Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
INVITE_FROM_EMAIL=

# MCP deployment: use public HTTPS origins for API_BASE_URL / FRONTEND_URL.
# Set the actual number of trusted proxy hops (0 for direct connections).
TRUST_PROXY_HOPS=0

# GitHub App OAuth client (Request user authorization during installation) -- secret
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=

# GitHub webhooks: set the same secret in the App settings; webhook URL = <API>/api/webhooks/github.
# Webhook processing stays disabled (503) while this is empty.
# GITHUB_WEBHOOK_SECRET=

# Per-repository limits for one sync run (hard-capped at 500 per category)
# GITHUB_SYNC_ISSUE_LIMIT=200
# GITHUB_SYNC_PR_LIMIT=200
# GITHUB_SYNC_COMMIT_LIMIT=50

# Base URL of the aiml FastAPI service (python -m uvicorn app.main:app --port 8001 --app-dir aiml)
# AI_SERVICE_URL=http://127.0.0.1:8001

# Repository content analysis budget (per run). Files over the size limit, beyond the file/byte budget,
# secrets, binaries and dependency/build directories are skipped and reported as coverage limitations.
# GITHUB_ANALYSIS_MAX_FILES=150
# GITHUB_ANALYSIS_MAX_FILE_BYTES=100000
# GITHUB_ANALYSIS_MAX_TOTAL_BYTES=3000000
# GITHUB_ANALYSIS_MAX_FILE_CHARS=40000
# GITHUB_ANALYSIS_CONCURRENCY=5
